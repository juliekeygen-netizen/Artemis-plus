<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/gamePhysicalRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:clipChildren="false"
    tools:context=".Game">

    <!--
        The complete in-stream visual tree lives under one transform boundary. In normal mode this
        is a match-parent FrameLayout. Experimental sideways mode swaps its logical width/height and
        rotates this root while the Activity/window itself stays physically portrait, keeping Android
        system gestures/navigation on the phone's short edge.
    -->
    <FrameLayout
        android:id="@+id/gameVisualRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:clipChildren="false">

        <View
            android:id="@+id/backgroundTouchView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

        <com.limelight.ui.StreamContainer
            android:id="@+id/streamContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:defaultFocusHighlightEnabled="false"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:focusedByDefault="true">
            <requestFocus />
        </com.limelight.ui.StreamContainer>

        <TextView
            android:id="@+id/notificationOverlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="10dp"
            android:layout_gravity="right"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:gravity="right"
            android:background="#80000000"
            android:preferKeepClear="true"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/performanceOverlay"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/performanceOverlayBig"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:layout_gravity="left"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:gravity="left"
                android:background="#80000000"
                android:preferKeepClear="true"
                android:visibility="gone" />

            <TextView
                android:id="@+id/performanceOverlayLite"
                tools:text="延迟/解码：109ms/7ms 丢包率：69% FPS：60"
                android:textSize="10sp"
                android:layout_marginTop="4dp"
                android:background="@drawable/ic_hud_bg"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:visibility="gone"
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <com.limelight.ui.PersistentPositionImageButton
            android:id="@+id/floatingMenuButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="top|start"
            android:layout_marginTop="24dp"
            android:background="@drawable/floating_menu_button"
            android:contentDescription="@string/menu_button"
            android:src="@drawable/ic_menu"
            android:padding="6dp"
            android:visibility="gone"
            android:elevation="9999dp" />

        <com.limelight.ui.PersistentPositionImageButton
            android:id="@+id/overlayToggleZoomButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="24dp"
            android:background="@drawable/floating_menu_button"
            android:src="@drawable/ic_zoom_toggle"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/toggle_pan_zoom_mode"
            android:visibility="gone"
            android:elevation="9999dp" />

        <com.limelight.overlay.StatsOverlay
            android:id="@+id/statsOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible" />

        <com.limelight.overlay.ReconnectOverlay
            android:id="@+id/reconnectOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

    </FrameLayout>
</FrameLayout>
